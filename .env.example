# Variables d'environnement du serveur Node (déploiement Infomaniak).
#
# Deux façons de les fournir, au choix :
#   - dans le Manager Infomaniak (site Node.js → variables d'environnement)
#   - ou en copiant ce fichier en `.env` à la racine du site sur le serveur
# Le Manager l'emporte : le fichier ne remplace jamais une variable déjà définie.
#
# ⚠️ Ne PAS téléverser un `.env` rempli par FTP depuis le dépôt : le script de
# déploiement l'exclut volontairement. On le crée directement sur le serveur.

# --- indispensables ---------------------------------------------------------
# Port : imposé par Infomaniak, ne pas le fixer à la main.
PUBLIC_BASE_URL=https://dev1.mdcdy.be
# Emplacement de la base SQLite. À METTRE HORS du dossier déployé, sinon un
# redéploiement pourrait l'écraser. Chemin absolu recommandé.
SQLITE_PATH=/home/clients/xxxx/data/gites.db
# Jeton du back-office — OBLIGATOIRE (garde fail-closed : sans lui, /api/admin
# refuse tout). Chaîne longue et aléatoire.
ADMIN_TOKEN=
# Clé du déclencheur de tâche planifiée (/internal/cron?key=…).
CRON_KEY=

# --- paiement : clés de REPLI uniquement ------------------------------------
# Un compte Stripe par propriété (décision du 11/10/2026) : les clés se collent
# dans Réglages > Comptes Stripe (voir docs/paiements-stripe.md). Ces variables ne
# servent plus que de repli, pour une propriété qui n'a pas encore ses clés.
# Vides = simulateur de paiement. Ne mettre ici que des clés de TEST.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- emails (rester à false tant que l'envoi réel n'est pas décidé) ---------
EMAILS_ENABLED=false
# Envoi par SMTP (la boîte Infomaniak, transport du site Node) : actif quand les
# quatre SMTP_HOST, SMTP_USER, SMTP_PASSWORD, MAIL_FROM sont posés ET
# EMAILS_ENABLED=true. Prime sur Resend. Adresse prévue : reservations@ sur le
# domaine définitif (à créer dans le Manager, Service Mail).
#   465 = TLS dès la connexion (défaut) · 587 = STARTTLS, obligatoire (jamais
#   de mot de passe en clair). SMTP_SECURE=true|false force le choix.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=reservations@domaine-definitif.be
SMTP_PASSWORD=
MAIL_FROM="Les Gîtes du Pré Moré <reservations@domaine-definitif.be>"
# Resend : le transport de Cloudflare Workers ; inutile sur Infomaniak.
RESEND_API_KEY=
RESEND_FROM="Les Gîtes du Pré Moré <reservation@dev1.mdcdy.be>"

# --- boîte de contact des gîtes (relève IMAP, site Node seulement) ----------
# Décision du 11/10/2026 : tous les messages reviennent dans la plateforme (docs/messagerie.md).
# Gmail dédié + « mot de passe d'application » (validation en deux étapes requise sur le
# compte Google, puis Compte Google > Sécurité > Mots de passe des applications).
# Actif dès que IMAP_USER et un mot de passe sont posés. La boîte n'est JAMAIS modifiée
# (ouverte en lecture seule). IMAP_PASSWORD retombe sur SMTP_PASSWORD s'il est vide.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=lesgitesdupremore@gmail.com
IMAP_PASSWORD=
# Filet entre deux passages du cron (minutes, 0 = seulement au cron).
MAILBOX_POLL_MINUTES=10
# Pour que les réponses partent AUSSI depuis cette adresse (même fil chez le client) :
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<la même adresse>
#   SMTP_PASSWORD=<le même mot de passe d'application>  MAIL_FROM="Les Gîtes du Pré Moré <la même adresse>"

# --- canaux OTA -------------------------------------------------------------
BEDS24_REFRESH_TOKEN=
BEDS24_WEBHOOK_KEY=
# Écritures Beds24 (calendriers poussés, réponses aux canaux, messages marqués
# lus) : FERMÉES par défaut, le https ne suffit plus. Seule la valeur « true »
# les ouvre — à poser en production, jamais sur un essai.
BEDS24_WRITE_ENABLED=true

# --- accès à l'écran d'administration (/admin/) ------------------------------
# Accès administrateur fermé au public : adresses ou plages CIDR autorisées sur
# /api/admin/* et /admin/ (virgules ou espaces). VIDE = ouvert à tous
# (défaut). Une entrée illisible ferme tout. La garde ne vise que les HUMAINS
# (sessions, ADMIN_TOKEN) : une clé de service « svc: » et le compte réservé
# « sauvegarde » passent depuis toute adresse (ils partent du Mac, IP
# domestique changeante ; droits déjà bornés). Exemple :
# ADMIN_ALLOWED_IPS=81.82.83.84, 2a02:1810::/48
ADMIN_ALLOWED_IPS=
# Derrière le proxy d'Infomaniak, l'adresse du client est lue dans la DERNIÈRE
# entrée de X-Forwarded-For. À mettre à true seulement derrière un proxy de
# confiance (sinon un client pourrait se faire passer pour une adresse permise).
# TRUST_PROXY=true
# Photos envoyées depuis le back-office : dossier HORS du site déployé (un
# redéploiement ne doit pas les effacer), servi sous /uploads/. Relatif au
# dossier du site, ou absolu. Défaut : ../gites-data/uploads
# UPLOADS_DIR=/home/clients/xxxx/gites-data/uploads
