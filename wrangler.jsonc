// Configuration wrangler — plateforme de gestion des gîtes.
// ⚠️ AUCUN déploiement en production sans accord explicite de Julien.
// Déployer passe par `make livrer` (production) ou `make livrer-essai` (essai),
// jamais par un `wrangler deploy` à la main : voir le Makefile.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gites-platform",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // Fichiers statiques : back-office (/admin) + page publique de réservation (/book).
  // run_worker_first : les routes dynamiques passent par le Worker avant les assets.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ical/*", "/"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gites-platform",
      "database_id": "8ecf7b7c-5f2f-4292-861e-b945aff53042", // base réelle (WEUR), créée le 2026-08-03
      "migrations_dir": "migrations"
    }
  ],

  // Cron 15 min : import iCal (Airbnb Moulin, phase 3) + expiration des holds + rappels de solde.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // ── Intégration email (à activer AU DÉPLOIEMENT, jamais avant — README § email) ──
  // 1. Cloudflare Email Routing sur le domaine (MX) : adresse
  //    reservation@lesgitesdupremore.be → action « Send to Worker » → gites-platform.
  // 2. Le handler email() de src/index.ts fait le reste (stockage, accusé, transfert).
  // 3. L'accusé de réception (message.reply) ne demande aucun binding ; le transfert
  //    exige que l'adresse de destination soit vérifiée dans Email Routing.
  // Aucune section de config nécessaire ici tant que le routage n'est pas activé.

  "vars": {
    // ⚠️ 8788 en local : le 8787 est occupé par la surcouche Legal Ops (LaunchAgent).
    "PUBLIC_BASE_URL": "http://localhost:8788",
    // Les clés sensibles vont dans .dev.vars (local) ou `wrangler secret put` (prod) :
    // RESEND_API_KEY, RESEND_FROM, ADMIN_TOKEN. Stripe : un compte par propriété, clés
    // saisies dans Réglages > Comptes Stripe ; STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY
    // et STRIPE_WEBHOOK_SECRET ne sont plus qu'un repli (docs/paiements-stripe.md).
    "EMAILS_ENABLED": "false"
  },

  // Conserve les logs du Worker (sinon rien n'est retenu après coup, et une
  // exception applicative est introuvable). Une ligne, aucun service tiers.
  "observability": { "enabled": true },

  // ── Environnement de production ────────────────────────────────────────────
  // Le bloc racine ci-dessus reste la config LOCALE. Auparavant, le runbook
  // demandait de modifier PUBLIC_BASE_URL en place au déploiement : tout
  // `npm run dev` suivant fabriquait alors des liens de paiement, des vouchers
  // et des URLs iCal pointant sur la PRODUCTION (audit ECC 2026-07-30).
  // Déploiement : `wrangler deploy --env production`.
  // ⚠️ `vars` et `d1_databases` ne sont PAS hérités du bloc racine par les
  //     environnements nommés — ils sont donc répétés ici volontairement.
  "env": {
    "production": {
      // Nom explicite : sans lui, wrangler déploierait « gites-platform-production ».
      "name": "gites-platform",
      "vars": {
        "PUBLIC_BASE_URL": "https://gites-platform.j-decartier.workers.dev", // TEST public 2026-08-03 — à caler sur le domaine retenu (décision D5)
        "EMAILS_ENABLED": "false",                 // passer à "true" une fois Resend + DKIM vérifiés
        "BEDS24_WRITE_ENABLED": "true"             // réactivé le 2026-08-03 (demande Julien) — INDISPENSABLE depuis le 10/10/2026 : sans « true », aucune écriture Beds24 (fermé par défaut)
      },
      "assets": {
        "directory": "public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/ical/*", "/"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gites-platform",
          "database_id": "8ecf7b7c-5f2f-4292-861e-b945aff53042", // base réelle (WEUR), créée le 2026-08-03
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "observability": { "enabled": true }
    },

    // ── Environnement d'essai (09/10/2026, méthode Greffe) ──────────────────
    // Un Worker et une base À PART : rien de ce qu'on y fait ne touche la
    // production. `make livrer-essai` y déploie la branche courante ; on y
    // essaie une migration ou un écran avant `make livrer`.
    // - Base D1 `gites-platform-essai` (WEUR, créée le 2026-10-09) : migrations
    //   et seed rejoués depuis zéro, aucune donnée de la production.
    // - Courriels coupés (EMAILS_ENABLED=false), paiement simulé (aucune clé
    //   Stripe), Beds24 coupé : AUCUN secret BEDS24_* ne doit y être posé.
    //   Depuis le 10/10/2026, beds24WritesAllowed() est fermé par défaut : seul
    //   BEDS24_WRITE_ENABLED="true" autorise une écriture, le https ne suffit
    //   plus. L'absence de BEDS24_REFRESH_TOKEN reste la première barrière.
    // - Seul secret : ADMIN_TOKEN d'essai, distinct de la production, lu dans
    //   `.secrets.essai` (gitignoré) par `make livrer-essai`.
    "essai": {
      "name": "gites-platform-essai",
      "vars": {
        "PUBLIC_BASE_URL": "https://gites-platform-essai.j-decartier.workers.dev",
        "EMAILS_ENABLED": "false",
        "BEDS24_WRITE_ENABLED": "false"
      },
      "assets": {
        "directory": "public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/ical/*", "/"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gites-platform-essai",
          "database_id": "154b7bd2-8e17-45f5-b230-1faf85fca44e", // base d'essai (WEUR), créée le 2026-10-09
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "observability": { "enabled": true }
    }
  }
}
